{
	"name": "marsender/symfony-webhook",
	"description": "Symfony webhook",
	"type": "project",
	"version": "1.0.0",
	"license": "GPL-3.0-or-later",
	"minimum-stability": "stable",
	"prefer-stable": true,
	"require": {
		"php": ">=8.4",
		"ext-ctype": "*",
		"ext-iconv": "*",
		"doctrine/dbal": "^4.6",
		"doctrine/doctrine-bundle": "^3.4",
		"doctrine/doctrine-migrations-bundle": "^4.0",
		"doctrine/orm": "^3.8",
		"phpdocumentor/reflection-docblock": "^5.6.3",
		"symfony/asset": "8.1.*",
		"symfony/asset-mapper": "8.1.*",
		"symfony/console": "8.1.*",
		"symfony/doctrine-messenger": "8.1.*",
		"symfony/dotenv": "8.1.*",
		"symfony/expression-language": "8.1.*",
		"symfony/flex": "^2.12",
		"symfony/form": "8.1.*",
		"symfony/framework-bundle": "8.1.*",
		"symfony/http-client": "8.1.*",
		"symfony/intl": "8.1.*",
		"symfony/mailer": "8.1.*",
		"symfony/mime": "8.1.*",
		"symfony/monolog-bundle": "^4.1",
		"symfony/notifier": "8.1.*",
		"symfony/process": "8.1.*",
		"symfony/property-access": "8.1.*",
		"symfony/property-info": "8.1.*",
		"symfony/runtime": "8.1.*",
		"symfony/security-bundle": "8.1.*",
		"symfony/serializer": "8.1.*",
		"symfony/stimulus-bundle": "^3.7",
		"symfony/string": "8.1.*",
		"symfony/translation": "8.1.*",
		"symfony/twig-bundle": "8.1.*",
		"symfony/ux-turbo": "^3.7",
		"symfony/validator": "8.1.*",
		"symfony/web-link": "8.1.*",
		"symfony/webhook": "8.1.*",
		"symfony/yaml": "8.1.*",
		"twig/extra-bundle": "^3.29",
		"twig/twig": "^3.30"
	},
	"config": {
		"allow-plugins": {
			"composer/package-versions-deprecated": true,
			"php-http/discovery": true,
			"symfony/flex": true,
			"symfony/runtime": true
		},
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"autoload": {
		"psr-4": {
			"App\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\Tests\\": "tests/"
		}
	},
	"replace": {
		"symfony/polyfill-ctype": "*",
		"symfony/polyfill-iconv": "*",
		"symfony/polyfill-php72": "*",
		"symfony/polyfill-php73": "*",
		"symfony/polyfill-php74": "*",
		"symfony/polyfill-php80": "*",
		"symfony/polyfill-php81": "*",
		"symfony/polyfill-php82": "*"
	},
	"scripts": {
		"auto-scripts": {
			"cache:clear": "symfony-cmd",
			"assets:install %PUBLIC_DIR%": "symfony-cmd",
			"importmap:install": "symfony-cmd"
		},
		"post-install-cmd": [
			"@auto-scripts"
		],
		"post-update-cmd": [
			"@auto-scripts"
		],
		"deploy": [
			"composer cache-clear; rm -rf public/assets; bin/console asset-map:compile"
		],
		"cache-clear": [
			"sudo -u www-data bin/console cache:clear"
		],
		"test": [
			"if php -m | grep -q 'xdebug'; then ./bin/phpunit -c ./phpunit.xml --exclude-group failure --coverage-clover var/coverage/coverage.xml && vendor/bin/php-coverage-badger var/coverage/coverage.xml .github/badges/coverage.svg; else ./bin/phpunit -c ./phpunit.xml --exclude-group failure --no-coverage; fi"
		],
		"php-cs-fixer": [
			"vendor/bin/php-cs-fixer fix --allow-risky=yes --using-cache=no --config .php-cs-fixer.php src tests"
		],
		"twig-cs-fixer": [
			"vendor/bin/twig-cs-fixer lint --fix templates"
		],
		"rector": [
			"vendor/bin/rector process"
		],
		"phpstan": [
			"vendor/bin/phpstan analyse"
		],
		"fix": [
			"composer rector && composer test && composer php-cs-fixer && composer twig-cs-fixer"
		]
	},
	"conflict": {
		"symfony/symfony": "*"
	},
	"extra": {
		"symfony": {
			"allow-contrib": true,
			"require": "8.1.*",
			"docker": true
		}
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.76.0",
		"jaschilz/php-coverage-badger": "^2.0",
		"phpstan/phpdoc-parser": "^2.0",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^13.4",
		"rector/rector": "^2.1.2",
		"symfony/browser-kit": "8.1.*",
		"symfony/css-selector": "8.1.*",
		"symfony/debug-bundle": "8.1.*",
		"symfony/maker-bundle": "^1.68",
		"symfony/phpunit-bridge": "8.1.*",
		"symfony/stopwatch": "8.1.*",
		"symfony/web-profiler-bundle": "8.1.*",
		"vincentlanglet/twig-cs-fixer": "^4.1"
	}
}
